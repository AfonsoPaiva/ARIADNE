<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude test classes, benchmarks, and demo -->
    <Match>
        <Class name="~.*\.*Test.*" />
    </Match>
    <Match>
        <Class name="~io\.ariadne\.benchmark\..*" />
    </Match>
    <Match>
        <Class name="~io\.ariadne\.demo\..*" />
    </Match>

    <!-- Exclude generated JMH classes -->
    <Match>
        <Class name="~.*_jmhType.*" />
    </Match>
    <Match>
        <Class name="~.*_jmhTest.*" />
    </Match>

    <!-- Exclude ByteBuddy shaded package -->
    <Match>
        <Package name="~io\.ariadne\.shaded\..*" />
    </Match>

    <!-- Exclude representation exposure for singletons, carriers, results, and links -->
    <!-- Essential to maintain zero-allocation performance invariants without defensive copying -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="MS_PKGPROTECT" />
    </Match>
    <Match>
        <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT" />
    </Match>
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL" />
    </Match>
    <!-- ================================================================
         ByteBuddy @Advice false positives — DLS_DEAD_LOCAL_STORE
         ================================================================
         In ByteBuddy Advice, parameters annotated with
           @Advice.Argument(value = N, readOnly = false)
         MUST be reassigned inside @Advice.OnMethodEnter to rewrite the
         corresponding argument at the instrumented call site. SpotBugs
         analyses the advice source class in isolation and cannot see that
         the assignment is inlined into the target method bytecode; it
         therefore reports every such reassignment as a "dead local store".
         The reassignment is semantically correct and load-bearing.
         Exclusion is scoped strictly to the three *Advice classes. -->
    <Match>
        <Class name="~io\.ariadne\.agent\.(CompletableFutureAdvice|ExecutorAdvice|ThreadAdvice)(\$.*)?"/>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
    </Match>

</FindBugsFilter>
