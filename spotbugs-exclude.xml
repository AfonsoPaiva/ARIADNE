<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude test classes, benchmarks, and demo -->
    <Match>
        <Class name="~.*\.*Test.*" />
    </Match>
    <Match>
        <Class name="~io\.ariadne\.benchmark\..*" />
    </Match>
    <Match>
        <Class name="~io\.ariadne\.demo\..*" />
    </Match>

    <!-- Exclude generated JMH classes -->
    <Match>
        <Class name="~.*_jmhType.*" />
    </Match>
    <Match>
        <Class name="~.*_jmhTest.*" />
    </Match>

    <!-- Exclude ByteBuddy shaded package -->
    <Match>
        <Package name="~io\.ariadne\.shaded\..*" />
    </Match>

    <!-- Exclude representation exposure for singletons, carriers, results, and links -->
    <!-- Essential to maintain zero-allocation performance invariants without defensive copying -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="MS_PKGPROTECT" />
    </Match>
    <Match>
        <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT" />
    </Match>
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL" />
    </Match>
</FindBugsFilter>
